#!/usr/bin/env python3
# MISE description="Emit a JSON map of which mise.toml [tools] entries changed since a given git ref"
import json
import os
import subprocess
import sys

import tomllib


def load_tools(ref: str) -> dict:
    proc = subprocess.run(
        ["git", "show", f"{ref}:mise.toml"], capture_output=True, check=False
    )
    if proc.returncode != 0:
        return {}
    return tomllib.loads(proc.stdout.decode()).get("tools", {})


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit("usage: ci-tool-bumps <base-ref>")
    os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    base_tools = load_tools(sys.argv[1])
    head_tools = load_tools("HEAD")
    changed = {
        key: base_tools.get(key) != head_tools.get(key)
        for key in set(base_tools) | set(head_tools)
    }
    print(json.dumps(changed))


if __name__ == "__main__":
    main()
