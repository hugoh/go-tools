{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hugoh/go-tools:go-renovaterc",
    "github>hugoh/renovate-config//presets/npm-renovate-debounce"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the hugoh/hk-config Pkl package pin in the Copier template's hk.pkl.jinja (not caught by hk-config's own .pkl-only customManager)",
      "managerFilePatterns": ["/^template/hk\\.pkl\\.jinja$/"],
      "matchStrings": [
        "package://github\\.com/hugoh/hk-config/releases/download/v[^/]+/hk-config@(?<currentValue>[^#]+)#"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "hugoh/hk-config",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "package://github.com/hugoh/hk-config/releases/download/v{{{newValue}}}/hk-config@{{{newValue}}}#"
    },
    {
      "customType": "regex",
      "description": "Bump the jdx/hk pin in the Copier template's hk.pkl.jinja (not caught by hk-config's own .pkl-only customManager)",
      "managerFilePatterns": ["/^template/hk\\.pkl\\.jinja$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v[^/]+/hk@(?<currentValue>[^#]+)#"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the jdx/hk pin in the Copier template's mise.toml.jinja (hk-config's manager only matches files named mise.toml, and the built-in mise manager is disabled for hk)",
      "managerFilePatterns": ["/^template/mise\\.toml\\.jinja$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)hk\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*(?:\\r\\n|\\r|\\n|$)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
      "/(^|/)action\\.ya?ml$/",
      "/^template/\\.github/workflows/semantic-pr\\.yml\\.jinja$/"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "description": "These pins reach consumers only once go-tools cuts a new tag (go-*.yml via copier update's uses: hash pins, the template's semantic-pr.yml.jinja via its own gh-workflows pin), so force fix (not chore) to make cocogitto's `cog bump --auto` release them. go-tools' own ci.yml and semantic-pr.yml are excluded: they're never consumed externally.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        "go-*.yml",
        "template/.github/workflows/semantic-pr.yml.jinja"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "The shared preset disables hugoh/gh-workflows bumps in semantic-pr.yml for consumers (Copier-owned there); go-tools' own copy is the one place Renovate must keep it current.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["hugoh/gh-workflows"],
      "matchFileNames": [".github/workflows/semantic-pr.yml"],
      "enabled": true
    },
    {
      "description": "Same reasoning as above: template/mise.toml.jinja's tool pins only reach consumers via a new go-tools tag.",
      "matchManagers": ["mise"],
      "matchFileNames": ["template/mise.toml.jinja"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Same reasoning as above: template/hk.pkl.jinja's and template/mise.toml.jinja's hk-config/jdx-hk pins only reach consumers via a new go-tools tag.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["template/hk.pkl.jinja", "template/mise.toml.jinja"],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["pytest"],
      "groupName": "pytest (test infra)"
    },
    {
      "description": "Group non-major bumps to the repo's own mise.toml into one 'dev tools' PR instead of one per tool. npm:renovate keeps its debounce schedule; Go toolchain bumps stay standalone.",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchDepNames": ["!npm:renovate"],
      "matchDatasources": ["!golang-version"],
      "groupName": "dev tools"
    },
    {
      "description": "Same for template/mise.toml.jinja, kept a separate group so the batch stays `fix` (per the rule above) and cuts one go-tools release + one copier fan-out instead of one per tool.",
      "matchManagers": ["mise"],
      "matchFileNames": ["template/mise.toml.jinja"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchDatasources": ["!golang-version"],
      "groupName": "template dev tools"
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "**/{,.}mise{,.*}.toml",
      "**/{,.}mise/config{,.*}.toml",
      "**/.config/mise{,.*}.toml",
      "**/.config/mise/{mise,config}{,.*}.toml",
      "**/.config/mise/conf.d/*.toml",
      "**/.rtx{,.*}.toml",
      "/^template/mise\\.toml\\.jinja$/"
    ]
  }
}
