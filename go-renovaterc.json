{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "github>hugoh/hk-config//renovate.json",
    ":automergeLinters",
    ":automergeMinor",
    ":automergeDigest",
    "schedule:monthly",
    "github>hugoh/renovate-config//presets/vulnerability-alerts",
    "github>hugoh/renovate-config//presets/major-updates-ungrouped"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    },
    {
      "description": "ci.yml's hugoh/go-tools reusable-workflow pins are Copier-owned (regenerated with a version comment on every `copier update`), so keep Renovate's github-actions manager off them to avoid the two racing. Scoped to ci.yml only: a hand-maintained workflow that calls a go-tools reusable workflow (e.g. a repo-specific compat matrix) still gets managed normally.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["hugoh/go-tools"],
      "matchFileNames": [".github/workflows/ci.yml"],
      "enabled": false
    },
    {
      "matchManagers": ["copier"],
      "matchPackageNames": ["https://github.com/hugoh/go-tools.git"],
      "extends": ["github>hugoh/renovate-config//presets/chain-debounce"],
      "automerge": true
    },
    {
      "description": "mise.ci.toml is NOT Copier-managed (only repos that commit it directly, e.g. for CI-only tools like jj) — let Renovate bump it normally.",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.ci.toml"],
      "enabled": true
    }
  ],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
}
