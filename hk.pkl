amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v2.0.0/hk-config@2.0.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
  ...Base.base
  // Deliberately scoped to just mise-tasks/* glob, not the builtins'
  // default match_any (which now also matches any shebang-detected shell
  // script by type, e.g. template/mise-tasks/* — the copier template's own
  // scripts, checked separately via render-check, not here).
  ["shellcheck_dev_tasks"] = (Builtins.shellcheck) {
    match_any = List((FileSelector) { glob = List("mise-tasks/*") })
  }
  ["shellharden_dev_tasks"] = (Builtins.shellharden) {
    glob = List("mise-tasks/*")
  }
  ["shfmt_dev_tasks"] = (Builtins.shfmt) {
    match_any = List((FileSelector) { glob = List("mise-tasks/*") })
  }
  // template/mise.toml.jinja is kept parseable as raw TOML (see
  // test_mise_toml_jinja_is_raw_toml), but its .jinja extension keeps it out
  // of tombi/tombi_format's default `**/*.toml` glob, so it's checked here
  // explicitly.
  ["tombi_template_mise"] = (Builtins.tombi) {
    glob = "template/mise.toml.jinja"
  }
  ["tombi_format_template_mise"] = (Builtins.tombi_format) {
    glob = "template/mise.toml.jinja"
  }
  ...Base.python
  ["ty"] = (Builtins.ty) {
    check = "uv venv --quiet --clear --python 3.11 .cache/ty-venv && uv pip install --quiet --python .cache/ty-venv -r test/requirements-render-check.txt && uvx --with ty==0.0.57 ty check --python .cache/ty-venv {{files}}"
  }
  ...Base.renovate
  // Split into its own profile (rather than "ci") so the main CI hk job
  // doesn't run this on every push; a separate, paths-filtered CI job
  // invokes it with --profile ci-renovate only when renovate config files
  // changed.
  ["renovate_config_validator"] = (Base.renovate["renovate_config_validator"]) {
    glob = List(".renovaterc.json", "go-renovaterc.json", "presets/*.json", "template/.renovaterc.json")
    profiles = List("ci-renovate")
  }
  ["template_managed_marker"] = new Step {
    glob = List("template/**/*")
    batch = true
    check = "test/check-template-marker.sh {{files}}"
  }
  ["conventional_commit"] {
    check = "cog check --from-latest-tag"
  }
}

steps = linters

hooks {
    ["pre-commit"] {
        stash = "git"
    }
    ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
    }
  }
}
